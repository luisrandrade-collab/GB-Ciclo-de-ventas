// Gourmet Bites v7 — Cloud Storage Security Rules
// Diseñadas: 2026-05-09 PM (post-incidente de pagos perdidos)
//
// MODELO: defensa en profundidad sobre evidencia financiera/legal.
//
// Carpetas y reglas:
//   pagos/                  — comprobantes de pago. INMUTABLE.
//   entregas/               — fotos de entrega. INMUTABLE.
//   facturas/               — facturas electrónicas. INMUTABLE.
//   comprobantes-compras/   — comprobantes de compras. INMUTABLE.
//   comentarios/            — fotos de comentarios en pedidos. INMUTABLE.
//   pdfs/                   — PDFs generados (cotizaciones, propuestas). INMUTABLE.
//   productos/              — fotos del catálogo. MUTABLE (editor v7.9.1).
//
// "Inmutable" = create OK, update/delete bloqueado desde SDK.
// El owner del proyecto puede borrar manualmente vía Firebase Console
// si es estrictamente necesario (ej. limpieza de huérfanos), pero no hay
// código del app que pueda borrar evidencia.
//
// Para deployar:
//   firebase deploy --only storage:rules

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ─── Whitelist humano (mismo patrón que firestore.rules) ───
    // v7.9.4.2: roles separados.
    // Admin: Luis, JP, Kathy → CRUD evidencia (subir comprobantes, fotos catálogo).
    // Comercial (read-only): Emilio → solo ve evidencia. PDFs/Excel se generan
    //   client-side (no requieren upload), así que descarga reportes sin write.
    function isHumanAdmin() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email in [
               'luisrandrade@gmail.com',
               'juanpandrade2005@gmail.com',
               'kathy.matuk@gmail.com'
             ];
    }

    function isHumanReadOnly() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email in [
               'eammv1997@gmail.com'
             ];
    }

    function isHumanAuthorized() {
      return isHumanAdmin() || isHumanReadOnly();
    }

    function isAuthorized() {
      return isHumanAuthorized() || (
        request.auth != null
        && request.auth.uid == 'VjfJSGQ8yzZne7fcEB3elLsspOz2'
      );
    }

    function isImageUnder(maxBytes) {
      return request.resource.size < maxBytes
          && request.resource.contentType.matches('image/.*');
    }

    function isPdfUnder(maxBytes) {
      return request.resource.size < maxBytes
          && request.resource.contentType == 'application/pdf';
    }

    // ─── Default deny ────────────────────────────────────────
    // Cualquier path no listado abajo queda bloqueado.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // ─── pagos/ — INMUTABLE (evidencia financiera) ───────────
    // Crítico: aquí van los comprobantes de transferencia/efectivo.
    // No se puede borrar ni reemplazar desde la app — protege contra
    // bugs (uploads duplicados se quedan, hay que limpiar manualmente
    // con script auditable) y contra credenciales comprometidas.
    // v7.9.4.2: read = todos los humanos autorizados (Emilio puede ver
    //                 comprobantes para descargar/auditar reportes).
    //          create = solo admin (Emilio no sube evidencia).
    //          update/delete = false universal (evidencia inmutable).
    match /pagos/{file} {
      allow read: if isHumanAuthorized();
      allow create: if isHumanAdmin() && isImageUnder(10 * 1024 * 1024);
      allow update, delete: if false;
    }

    // ─── entregas/ — INMUTABLE (evidencia de entrega) ────────
    match /entregas/{file} {
      allow read: if isHumanAuthorized();
      allow create: if isHumanAdmin() && isImageUnder(10 * 1024 * 1024);
      allow update, delete: if false;
    }

    // ─── facturas/ — INMUTABLE (evidencia tributaria) ────────
    match /facturas/{file} {
      allow read: if isHumanAuthorized();
      allow create: if isHumanAdmin() && isImageUnder(10 * 1024 * 1024);
      allow update, delete: if false;
    }

    // ─── comprobantes-compras/ — INMUTABLE (evidencia compras) ──
    match /comprobantes-compras/{file} {
      allow read: if isHumanAuthorized();
      allow create: if isHumanAdmin() && isImageUnder(10 * 1024 * 1024);
      allow update, delete: if false;
    }

    // ─── comentarios/ — INMUTABLE (anotaciones operativas) ──
    match /comentarios/{file} {
      allow read: if isHumanAuthorized();
      allow create: if isHumanAdmin() && isImageUnder(10 * 1024 * 1024);
      allow update, delete: if false;
    }

    // ─── pdfs/ — INMUTABLE (legal/historical) ────────────────
    // Cotizaciones, propuestas y propuestas finales generadas.
    // Cada nueva versión sube como vNN_timestamp.pdf, las anteriores
    // quedan como historial inmodificable.
    // Emilio puede descargar PDFs históricos (read), pero no genera
    // nuevas cotizaciones que disparen upload (create solo admin).
    match /pdfs/{kind}/{docId}/{file} {
      allow read: if isHumanAuthorized();
      allow create: if isHumanAdmin() && isPdfUnder(20 * 1024 * 1024);
      allow update, delete: if false;
    }

    // ─── productos/ — read público + create/update admin, DELETE BLOQUEADO ──
    // v7.9.4.2: decisión Luis 10/05 — NINGÚN delete desde SDK, ni admin.
    // Para reemplazar foto: subir nueva con mismo path/nombre (Object Versioning
    // guarda la anterior como noncurrent, recuperable). Para borrar real: solo
    // desde Firebase Console manualmente. Esto previene que el editor del
    // catálogo (botón 🗑️ Foto) destruya evidencia accidentalmente.
    // CONSECUENCIA UI: el botón borrarFotoProducto() en el editor va a fallar
    //   con permission-denied. Si quieres mantener UX, cámbialo a "Reemplazar foto"
    //   que dispara upload de imagen vacía o sobrescribe con upload nuevo.
    match /productos/{file} {
      allow read: if true;
      allow create, update: if isHumanAdmin() && isImageUnder(5 * 1024 * 1024);
      allow delete: if false;
    }
  }
}
