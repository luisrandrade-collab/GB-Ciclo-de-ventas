// Gourmet Bites v7 — Firestore Security Rules
// Diseñadas: 2026-05-08 PM
// Pre-condición v7.9 #1
//
// MODELO: nivel B (medio) — whitelist de emails + ajustesLog append-only.
// Una vez deployado, requiere que la skill capture-receta migre a OAuth
// desktop flow (decisión 2026-05-08, aún pendiente).
//
// Para deployar:
//   firebase deploy --only firestore:rules
// Ver _internos/Firestore_rules_deploy_procedure.md

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Whitelist de usuarios autorizados ──────────────────────
    // Dos vías de autorización:
    //  - HUMANO: email verificado por Google + en la whitelist (defensa contra
    //    hijack de email vía registro email/password con un email ajeno).
    //  - SKILL BOT: identificado por UID exacto (su email es @gourmet-bites.app,
    //    no es real, entonces no se puede verificar — la defensa real es la
    //    secrecía del password). UID es único e inmutable.
    function isAuthorized() {
      return isHumanAuthorized() || isSkillBot();
    }

    // v7.9.4.2: roles separados por nivel
    // - Admin: Luis, JP, Kathy → CRUD completo
    // - Comercial (read-only): Emilio → solo lectura. Descarga reportes
    //   (PDFs y Excel se generan client-side, son funciones de lectura).
    //   NO puede crear cotizaciones, registrar pagos, anular, editar catálogo.
    function isHumanAdmin() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email in [
               'luisrandrade@gmail.com',
               'juanpandrade2005@gmail.com',
               'kathy.matuk@gmail.com'
             ];
    }

    function isHumanReadOnly() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email in [
               'eammv1997@gmail.com'
             ];
    }

    // Lectura: cualquier humano autorizado (admin o read-only).
    function isHumanAuthorized() {
      return isHumanAdmin() || isHumanReadOnly();
    }

    function isSkillBot() {
      // skill-bot@gourmet-bites.app — UID generado por Firebase al crear el user.
      // Si el bot se recrea (eliminado y vuelto a crear), actualizar este UID.
      return request.auth != null
          && request.auth.uid == 'VjfJSGQ8yzZne7fcEB3elLsspOz2';
    }

    // ─── Default deny ───────────────────────────────────────────
    // Cualquier path no listado abajo queda bloqueado para todos.
    // Esto incluye cualquier collection nueva que se cree sin actualizar
    // este archivo — mejor falla cerrada que abierta.
    match /{document=**} {
      allow read, write: if false;
    }

    // ─── Collections operativas ────────────────────────────────
    // v7.9.4.2: read = cualquier humano autorizado (admin + read-only).
    //           write = solo admin (Luis, JP, Kathy).

    // Cotizaciones GB-COT-*
    match /quotes/{docId} {
      allow read: if isHumanAuthorized();
      allow write: if isHumanAdmin();
    }

    // Propuestas iniciales GB-PROP-*
    match /proposals/{docId} {
      allow read: if isHumanAuthorized();
      allow write: if isHumanAdmin();
    }

    // Propuestas finales GB-PF-*
    match /propfinals/{docId} {
      allow read: if isHumanAuthorized();
      allow write: if isHumanAdmin();
    }

    // Directorio de clientes
    match /clients/{docId} {
      allow read: if isHumanAuthorized();
      allow write: if isHumanAdmin();
    }

    // Directorio de proveedores
    match /proveedores/{docId} {
      allow read: if isHumanAuthorized();
      allow write: if isHumanAdmin();
    }

    // Compras registradas
    match /compras/{docId} {
      allow read: if isHumanAuthorized();
      allow write: if isHumanAdmin();
    }

    // Catálogo de productos de compra frecuente
    match /preciosCatalogo/{docId} {
      allow read: if isHumanAuthorized();
      allow write: if isHumanAdmin();
    }

    // Productos custom registrados desde cotizaciones
    // Read: humanos autorizados + skill-bot. Write: solo admin.
    match /custom_products/{docId} {
      allow read: if isAuthorized();
      allow write: if isHumanAdmin();
    }

    // Configuración del sistema (ej. price_memory)
    match /config/{docId} {
      allow read: if isHumanAuthorized();
      allow write: if isHumanAdmin();
    }

    // Contadores transaccionales para consecutivos.
    // ⚠ Sin esta rule, NO SE PUEDEN CREAR cotizaciones/propuestas nuevas.
    // Solo admin escribe (read-only no crea cotizaciones).
    match /counters/{docId} {
      allow read: if isHumanAuthorized();
      allow write: if isHumanAdmin();
    }

    // ─── Catálogo (v7.9 BOM) ────────────────────────────────────
    // v7.9.7.3: lectura PRIVADA. catalogo.html público eliminado;
    // los emails del equipo viajaban en auditStamp.updatedByEmail y eran
    // legibles sin login mientras read=true. La landing pública futura
    // expondrá un subset saneado via Cloud Function o colección aparte.
    match /productos/{docId} {
      allow read: if isAuthorized();
      // Create: admin + skill-bot (este último para migraciones).
      allow create: if isHumanAdmin() || isSkillBot();
      // Update/Delete: solo admin (skill-bot NO modifica existentes).
      allow update, delete: if isHumanAdmin();
    }

    // Categorías editables del catálogo. Mismo modelo que productos.
    match /categorias/{docId} {
      allow read: if isAuthorized();
      allow create: if isHumanAdmin() || isSkillBot();
      allow update, delete: if isHumanAdmin();
    }

    // ─── Collections con acceso del skill-bot ───────────────────

    // Recetas internas (ingredientes + costos por producto).
    // Read: humanos autorizados + skill-bot. Write: admin + skill-bot.
    match /recetasInternas/{docId} {
      allow read: if isAuthorized();
      allow write: if isHumanAdmin() || isSkillBot();
    }

    // ─── Collections con restricciones especiales ───────────────

    // ajustesLog — append-only. Solo admin crea, nadie modifica/borra.
    match /ajustesLog/{docId} {
      allow read: if isHumanAuthorized();
      allow create: if isHumanAdmin();
      allow update, delete: if false;
    }

    // operacionesLog (v7.9.4) — audit log de operaciones críticas (pagos,
    // pedidos, aprobaciones, anulaciones). Patrón log-first: el cliente
    // crea con resultado='intento' antes de la operación, luego transiciona
    // a 'exito' o 'error'.
    //
    // Reglas:
    //  - create: humanos. resultado debe arrancar como 'intento' y
    //    usuarioUid debe ser el del auth (no impersonación).
    //  - read: humanos (vista Auditoría).
    //  - update: SOLO transición de 'intento' → 'exito'/'error' del mismo
    //    usuario que creó el log. Logs ya finalizados (exito/error) NO se
    //    pueden volver a modificar.
    //  - update (v7.9.4.1 hardening): además, solo puede modificar los campos del
    //    whitelist {resultado, completedAt, errorMsg, errorStack, duracionMs,
    //    payloadExtra}. Cualquier intento de tocar docId, payload, operacion,
    //    usuarioUid, timestamp, clientId, etc. → PERMISSION_DENIED. Esto
    //    protege la integridad del log original (lo que se reportó al iniciar
    //    la operación no puede reescribirse al cerrarla).
    //    payloadExtra existe para info que SOLO se conoce al cerrar (ej.
    //    submitPago reporta totalPagosDespues). No es parte del payload
    //    original, es metadata post-cierre.
    //  - delete: NUNCA. La auditoría es inmutable.
    match /operacionesLog/{logId} {
      // v7.9.4.2: read = todos los humanos autorizados (Emilio ve auditoría).
      //           create/update = solo admin (read-only no genera logs porque
      //                            no ejecuta operaciones de escritura).
      allow read: if isHumanAuthorized();
      allow create: if isHumanAdmin()
                    && request.resource.data.resultado == 'intento'
                    && request.resource.data.usuarioUid == request.auth.uid;
      allow update: if isHumanAdmin()
                    && resource.data.resultado == 'intento'
                    && request.resource.data.resultado in ['exito','error']
                    && resource.data.usuarioUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['resultado','completedAt','errorMsg','errorStack','duracionMs','payloadExtra']);
      allow delete: if false;
    }
  }
}
