// Gourmet Bites v7 — Firestore Security Rules
// Diseñadas: 2026-05-08 PM
// Pre-condición v7.9 #1
//
// MODELO: nivel B (medio) — whitelist de emails + ajustesLog append-only.
// Una vez deployado, requiere que la skill capture-receta migre a OAuth
// desktop flow (decisión 2026-05-08, aún pendiente).
//
// Para deployar:
//   firebase deploy --only firestore:rules
// Ver _internos/Firestore_rules_deploy_procedure.md

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Whitelist de usuarios autorizados ──────────────────────
    // Dos vías de autorización:
    //  - HUMANO: email verificado por Google + en la whitelist (defensa contra
    //    hijack de email vía registro email/password con un email ajeno).
    //  - SKILL BOT: identificado por UID exacto (su email es @gourmet-bites.app,
    //    no es real, entonces no se puede verificar — la defensa real es la
    //    secrecía del password). UID es único e inmutable.
    function isAuthorized() {
      return isHumanAuthorized() || isSkillBot();
    }

    function isHumanAuthorized() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email in [
               'luisrandrade@gmail.com'
             ];
    }

    function isSkillBot() {
      // skill-bot@gourmet-bites.app — UID generado por Firebase al crear el user.
      // Si el bot se recrea (eliminado y vuelto a crear), actualizar este UID.
      return request.auth != null
          && request.auth.uid == 'VjfJSGQ8yzZne7fcEB3elLsspOz2';
    }

    // ─── Default deny ───────────────────────────────────────────
    // Cualquier path no listado abajo queda bloqueado para todos.
    // Esto incluye cualquier collection nueva que se cree sin actualizar
    // este archivo — mejor falla cerrada que abierta.
    match /{document=**} {
      allow read, write: if false;
    }

    // ─── Collections operativas (CRUD completo solo humanos) ───
    // El skill-bot NO tiene acceso a estas — defensa en profundidad por si
    // se filtra el password del bot, el daño está acotado a recetasInternas.

    // Cotizaciones GB-COT-*
    match /quotes/{docId} {
      allow read, write: if isHumanAuthorized();
    }

    // Propuestas iniciales GB-PROP-*
    match /proposals/{docId} {
      allow read, write: if isHumanAuthorized();
    }

    // Propuestas finales GB-PF-*
    match /propfinals/{docId} {
      allow read, write: if isHumanAuthorized();
    }

    // Directorio de clientes
    match /clients/{docId} {
      allow read, write: if isHumanAuthorized();
    }

    // Directorio de proveedores
    match /proveedores/{docId} {
      allow read, write: if isHumanAuthorized();
    }

    // Compras registradas
    match /compras/{docId} {
      allow read, write: if isHumanAuthorized();
    }

    // Catálogo de productos de compra frecuente
    match /preciosCatalogo/{docId} {
      allow read, write: if isHumanAuthorized();
    }

    // Productos custom registrados desde cotizaciones
    // skill-bot puede leer (para skills que migran custom → catálogo principal).
    // Write sigue solo para humanos.
    match /custom_products/{docId} {
      allow read: if isAuthorized();
      allow write: if isHumanAuthorized();
    }

    // Configuración del sistema (ej. price_memory)
    match /config/{docId} {
      allow read, write: if isHumanAuthorized();
    }

    // Contadores transaccionales para consecutivos (quotes-YYYY, proposals-YYYY, propfinals-YYYY).
    // getNextNumber() en app-core.js usa runTransaction para get + set atómicos.
    // ⚠ Sin esta rule, NO SE PUEDEN CREAR cotizaciones/propuestas nuevas.
    match /counters/{docId} {
      allow read, write: if isHumanAuthorized();
    }

    // ─── Catálogo (v7.9 BOM) ────────────────────────────────────
    // Productos como entidad de primera clase, con metadata para BOM y web.
    // Read: humanos + skill-bot (skill-bot necesita leer para skills tipo
    //       match-fotos-instagram que cruzan datos externos contra el catálogo).
    // Create: humanos + skill-bot (skill-bot crea productos nuevos durante
    //         migraciones, ej. importar custom_products al catálogo).
    // Update/Delete: solo humanos. skill-bot NO modifica productos existentes —
    //                defensa en profundidad: si se filtra el password del bot,
    //                el daño está limitado a agregar productos nuevos (visibles
    //                y revertibles desde el editor).
    match /productos/{docId} {
      // Read PÚBLICO TOTAL sin auth — para que la página catalogo.html
      // (Linktree, web propia) pueda listar el catálogo sin login.
      // El frontend filtra por activo!=false y visibleEnWeb!=false.
      // Trade-off aceptado: usuario malicioso ve todos los productos
      // incluso archivados/ocultos, pero NO puede modificar nada.
      // No info ultra-sensible (nombres, precios, descripciones).
      allow read: if true;
      allow create: if isAuthorized();
      allow update, delete: if isHumanAuthorized();
    }

    // Categorías editables del catálogo. Mismo modelo que productos.
    match /categorias/{docId} {
      allow read: if true;
      allow create: if isAuthorized();
      allow update, delete: if isHumanAuthorized();
    }

    // ─── Collections con acceso del skill-bot ───────────────────

    // Recetas internas (ingredientes + costos por producto).
    // La skill capture-receta escribe acá. Acceso para humanos y skill-bot.
    match /recetasInternas/{docId} {
      allow read, write: if isAuthorized();
    }

    // ─── Collections con restricciones especiales ───────────────

    // ajustesLog — log auditable de descuentos/perdones (v7.8.3).
    // Append-only: se puede leer y crear, pero NO modificar ni borrar
    // entradas existentes. Esto preserva la auditoría histórica.
    // Si se necesita "anular" una entrada, agregar otra entrada nueva
    // que la referencie (no editar la original).
    // Solo humanos (el bot no tiene razón para escribir aquí).
    match /ajustesLog/{docId} {
      allow read, create: if isHumanAuthorized();
      allow update, delete: if false;
    }

    // operacionesLog (v7.9.4) — audit log de operaciones críticas (pagos,
    // pedidos, aprobaciones, anulaciones). Patrón log-first: el cliente
    // crea con resultado='intento' antes de la operación, luego transiciona
    // a 'exito' o 'error'.
    //
    // Reglas:
    //  - create: humanos. resultado debe arrancar como 'intento' y
    //    usuarioUid debe ser el del auth (no impersonación).
    //  - read: humanos (vista Auditoría).
    //  - update: SOLO transición de 'intento' → 'exito'/'error' del mismo
    //    usuario que creó el log. Logs ya finalizados (exito/error) NO se
    //    pueden volver a modificar.
    //  - delete: NUNCA. La auditoría es inmutable.
    match /operacionesLog/{logId} {
      allow read: if isHumanAuthorized();
      allow create: if isHumanAuthorized()
                    && request.resource.data.resultado == 'intento'
                    && request.resource.data.usuarioUid == request.auth.uid;
      allow update: if isHumanAuthorized()
                    && resource.data.resultado == 'intento'
                    && request.resource.data.resultado in ['exito','error']
                    && resource.data.usuarioUid == request.auth.uid;
      allow delete: if false;
    }
  }
}
